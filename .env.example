# Server Configuration
PORT=6002
HOST=0.0.0.0

# CORS and Host Security (Comma-separated list or * to allow all)
# Example for production domain:
ALLOWED_ORIGINS=https://aquasdr.velotriz.cloud,http://localhost:5173
ALLOWED_HOSTS=aquasdr.velotriz.cloud,api.aquasdr.velotriz.cloud,localhost,127.0.0.1

# Data storage path
AQUASDR_DATA_DIR=./data

# WebSocket Configuration
WS_PATH=/ws/telemetry
WS_MAX_PAYLOAD=1048576

# Express JSON payload limit
JSON_LIMIT=1mb
