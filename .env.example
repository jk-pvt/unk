# Server Configuration
PORT=6002
HOST=0.0.0.0

# CORS and Host Security (Comma-separated list or * to allow all)
# Example for production: ALLOWED_ORIGINS=https://yourdomain.com,https://your-app.netlify.app
ALLOWED_ORIGINS=*
ALLOWED_HOSTS=*

# Data storage path
AQUASDR_DATA_DIR=./data

# WebSocket Configuration
WS_PATH=/ws/telemetry
WS_MAX_PAYLOAD=1048576

# Express JSON payload limit
JSON_LIMIT=1mb
