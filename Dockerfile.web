# Build frontend
FROM node:20-alpine AS builder

WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# Serve with internal Nginx
FROM nginx:alpine

# Copy built frontend assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx template which supports environment variable substitution
COPY nginx.conf.template /etc/nginx/templates/default.conf.template

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]
