{
  "name": "aquasdr-mission-control",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"PORT=4318 node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "model:build": "node scripts/build-payload-model.mjs",
    "bench": "node scripts/bench.mjs",
    "afe:design": "python3 hardware/analog/design_afe.py && python3 hardware/analog/gen_schematic_svg.py",
    "arduino:sync": "node scripts/sync-arduino-engine.mjs",
    "arduino:build": "node scripts/sync-arduino-engine.mjs && AQUASDR_ARDUINO_BUILD=1 node --test tests/arduino-combined.test.js",
    "mcu:capture": "node scripts/mcu-capture.mjs",
    "mcu:reanalyze": "node scripts/reanalyze-mcu.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "serialport": "^13.0.0",
    "three": "^0.186.1",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^6.1.0"
  }
}
