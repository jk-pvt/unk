# Host Nginx for AquaSDR (TLS terminator in front of the Docker stack)
# Domain: aquasdr.in (+ www) -> 127.0.0.1:6002 (internal Nginx container)
# Issue the certificate with:
#   sudo certbot --nginx -d aquasdr.in -d www.aquasdr.in

server {
    listen 80;
    listen [::]:80;
    server_name aquasdr.in www.aquasdr.in;

    return 301 https://aquasdr.in$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name www.aquasdr.in;

    ssl_certificate /etc/letsencrypt/live/aquasdr.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/aquasdr.in/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://aquasdr.in$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name aquasdr.in;

    ssl_certificate /etc/letsencrypt/live/aquasdr.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/aquasdr.in/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://127.0.0.1:6002;

        # WebSocket support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Long timeout for persistent WebSocket telemetry connections
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }
}
