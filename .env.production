# Server Production Configuration
PORT=6002
HOST=0.0.0.0

# CORS & Host Restrictions for Domain
# Frontend domain: https://aquasdr.velotriz.cloud
# Backend domain / subdomains: https://api.aquasdr.velotriz.cloud (or direct origin)
ALLOWED_ORIGINS=https://aquasdr.velotriz.cloud,https://api.aquasdr.velotriz.cloud,http://localhost:5173,http://localhost:6002
ALLOWED_HOSTS=aquasdr.velotriz.cloud,api.aquasdr.velotriz.cloud,localhost,127.0.0.1

# Data storage path
AQUASDR_DATA_DIR=./data

# WebSocket Configuration
WS_PATH=/ws/telemetry
WS_MAX_PAYLOAD=1048576

# Express JSON payload limit
JSON_LIMIT=1mb
